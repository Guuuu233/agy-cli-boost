    "opencode2.mjs",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "antigravity",
    "agy",
    "acp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guuuu233/agy-cli-boost.git"
  },
  "homepage": "https://github.com/Guuuu233/agy-cli-boost#readme",
  "bugs": {
    "url": "https://github.com/Guuuu233/agy-cli-boost/issues"
  },
